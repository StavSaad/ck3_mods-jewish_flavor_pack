# A generic Mesopotamian ziggurat for the other temples of the old gods: three stages, one stair (tools/make_ziggurat_model.py --model generic)
pdxmesh = {
	name = "jip_ziggurat_generic_mesh"
	file = "jip_ziggurat_generic.mesh"

	scale = 1

	meshsettings = {
		name = "jip_ziggurat_generic_LOD0Shape"
		index = 0
		texture_diffuse = "building_persia_atlas_diffuse.dds"
		texture_normal = "building_persia_atlas_normal.dds"
		texture_specular = "building_persia_atlas_properties.dds"
		texture = { file = "jip_ziggurat_generic_unique.dds" index = 5 }
		shader = "standard_atlas"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}

entity = {
	name = "jip_ziggurat_generic_entity"
	pdxmesh = "jip_ziggurat_generic_mesh"
}
